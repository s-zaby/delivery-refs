# Nova Poshta API key (do not commit the real .env)
NOVA_POSHTA_API_KEY=your_api_key_here
# Ukrposhta Bearer token (for --provider ukrposhta)
UKRPOSHTA_API_TOKEN=your_bearer_token_here
# Optional settings
# NOVA_POSHTA_API_URL=https://api.novaposhta.ua/v2.0/json/
# NP_DATABASE=data/delivery.sqlite3
# NP_OUTPUT_DIR=data/np
# NP_API_PAGE_SIZE=500
# NP_API_TIMEOUT=60
# Throttling/retries for API rate limits
# NP_REQUEST_DELAY=0.3
# NP_MAX_RETRIES=5
# NP_BACKOFF_BASE=2
# Number of records in each generated JSON file
# NP_EXPORT_PAGE_SIZE=5000
